<%- include("../../views/partials/user/header") %>
<link rel="stylesheet" href="/css/product-details.css">
<main class="main">
    <div class="page-header breadcrumb-wrap">
        <div class="container">
            <div class="breadcrumb">
                <a href="/" rel="nofollow">Home</a>
                <!-- <span></span> Fashion -->
                <span></span> Product Detail Page
            </div>
        </div>
    </div>

    <section class="mt-50 mb-50">
        <div class="container">
            <div class="row">
                <div class="col-lg-9">
                    <div class="product-detail accordion-detail">
                        <div class="row mb-50">
                            <!-- Product Images Section -->
                            <div class="col-md-6 col-sm-12 col-xs-12">
                                <div class="detail-gallery">
                                    <!-- Main Image Display with Zoom -->
                                    <div class="zoom-container">
                                        <img id="main-product-image" class="border-radius-10 w-100" 
                                             src="/uploads/re-image/<%=product.productImage[0]%>" 
                                             alt="Main Product Image">
                                    </div>

                                    <!-- Thumbnail Slider -->
                                    <div class="thumbnail-slider mt-3">
                                        <% for (let i = 0; i < product.productImage.length; i++) { %>
                                            <div class="thumbnail-item">
                                                <img
                                                    class="thumbnail border-radius-10"
                                                    src="/uploads/re-image/<%= product.productImage[i] %>"
                                                    alt="Thumbnail <%= i + 1 %>"
                                                    onclick="changeMainImage('/uploads/re-image/<%= product.productImage[i] %>')"
                                                >
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <!-- Product Details Section -->
                            <div class="col-md-6 col-sm-12 col-xs-12">
                                <div class="detail-info">
                                    <h2 class="title-detail"><%= product.productName %></h2>

                                    <div class="product-detail-rating">
                                        <div class="product-rate-cover d-flex align-items-center justify-content-end">
                                            <!-- Star Rating -->
                                            <div class="product-rate d-inline-block position-relative">
                                                <div class="bg-light rounded-pill p-2">
                                                    <!-- Stars -->
                                                    <div class="text-warning">
                                                        <i class="fas fa-star"></i>
                                                        <i class="fas fa-star"></i>
                                                        <i class="fas fa-star"></i>
                                                        <i class="fas fa-star"></i>
                                                        <i class="fas fa-star-half-alt"></i>
                                                    </div>
                                                    <!-- Progress Bar -->
                                                    <div class="progress mt-2" style="height: 6px; width: 120px;">
                                                        <div class="progress-bar bg-warning" role="progressbar" style="width: 90%;" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- Reviews -->
                                            <span class="font-small ml-3 text-muted"> (25 reviews)</span>
                                        </div>
                                    </div>
                                    
                                    <div class="product-price-cover mt-3">
                                        <div class="product-price d-flex justify-content-between align-items-center p-4 bg-light rounded shadow-sm">
                                            <!-- Sale and Regular Price Section -->
                                            <div class="d-flex align-items-center">
                                                <h4 class="text-brand fw-bold me-4 mb-0">₹<%= product.salePrice %></h4>
                                                <h5 class="text-muted text-decoration-line-through me-4 mb-0" style="padding: 0px 20px ;text-decoration: line-through;">₹<%= product.regularPrice %></h5>
                                            </div>
                                            <!-- Offer Badge Section -->
                                            <span class="badge bg-success px-4 py-2 text-white fs-6">
                                                <% if (!totalOffer) { %>
                                                    No Offers
                                                <% } else { %>
                                                    <%= totalOffer %>% OFF
                                                <% } %>
                                            </span>
                                        </div>
                                    </div>
                                    
                                        
                                        
                                        <!-- Short Description -->
                                        <div class="short-desc mb-3">
                                            <p class=' mb-0' style="color: black;"><%= product.description %></p>
                                        </div>
                                        <hr class="border-color-1">
                                    
                                        <!-- Product Details -->



                                        <div style="font-family: Arial, sans-serif;">
                                            <label id="size-label" style="font-size: 16px;">Size: Small</label>
                                            <div style="margin-top: 10px; display: flex; gap: 10px;">
                                              <% const sizes = ['small', 'medium', 'large', 'xLarge']; %>
                                              <% const selectedSize = 'Small'; %> <!-- Default selected size -->
                                              <% const availability = { 
                                                    small: product.varient?.small || 0, 
                                                    medium: product.varient?.medium || 0, 
                                                    large: product.varient?.large || 0, 
                                                    XLarge: product.varient?.xLarge || 0 
                                              }; %>
                                            
                                              <% sizes.forEach(size => { %>
                                                <button 
                                                  class="size-button" 
                                                  data-size="<%= size %>">
                                                  <%= size %>
                                                </button>
                                              <% }); %>
                                            </div>
                                            <p id="availability" style="margin-top: 10px; font-size: 14px; color: green;">
                                              <span style="color: black; font-size: large;">Stock:</span> 
                                              <%= availability.Small > 0 ? `${availability.Small} Available` : 'Out of stock' %>
                                            </p>
                                          </div>
                                          
                                        
    
                                          
                                        <div class="product-details mb-3">
                                            <ul class="list-unstyled">

                                                <li>
                                                    <strong class="text-dark">Cloth Type:</strong> 
                                                    <span class="text-secondary">Nylon</span>
                                                </li>
                                            </ul>
                                        </div>
                                        <hr class="border-color-1">
                                    
                                        <!-- Additional Information -->
                                        <div class="product_sort_info">
                                            <ul class="list-unstyled">
                                                
                                                <li class="d-flex align-items-center mb-2">
                                                    <i class="fi-rs-refresh text-info me-2"></i> 
                                                    <span>7 Day Return Policy</span>
                                                </li>
                                                <li class="d-flex align-items-center">
                                                    <i class="fi-rs-credit-card text-success me-2"></i> 
                                                    <span>Cash on Delivery Available</span>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                    
                                    <div class="bt-1 border-color-1 mt-30 mb-30"></div>

                                    <div class="detail-extralink mt-4">
                                        <div class="d-flex align-items-center justify-content-start gap-3">
                                          
                                    
                                            <!-- Add to Cart Button -->
                                            <div class="product-actions mt-4">
                                                <form action="/addCart" method="POST">
                                                    <!-- Pass Product Details -->
                                                    <input type="hidden" name="productId" value="<%= product._id %>">
                                                    <input type="hidden" name="productName"
                                                        value="<%= product.productName %>">
                                                    <input type="hidden" name="productImage"
                                                        value="<%= product.productImage[0] %>">
                                                    <input type="hidden" name="regularPrice"
                                                        value="<%= product.regularPrice %>">
                                                    <input type="hidden" name="salePrice" value="<%= product.salePrice %>">
                                                    <input type="hidden" name="discount" value="<%= totalOffer || 0 %>">
    
                                                    <!-- Quantity Selector -->
                                                    <label for="quantity" class="form-label">Quantity:</label>
                                                    <div class="quantity-control d-flex align-items-center">
                                                        <!-- Decrease Button -->
                                                        <button type="button" class="btn btn-outline-secondary px-3"
                                                            id="decrease-btn">-</button>
    
                                                        <!-- Quantity Input -->
                                                        <input type="number" id="quantity" name="quantity" value="1" min="1"
                                                            max="5" class="form-control text-center mx-2 w-25" readonly />
    
                                                        <!-- Increase Button -->
                                                        <button type="button" class="btn btn-outline-secondary px-3"
                                                            id="increase-btn">+</button>

                                                            <button type="button" class="btn btn-success  position-relative" id="addToCartBtn">
                                                                <i class="fas fa-shopping-cart me-2"></i> Add to Cart
                                                              </button>
                                                    </div>
    
                                                    
                                                </form>
                                        </div>
                                    </div>
                                    

                                    <ul class="product-meta list-unstyled font-sm text-muted mt-4">
                                        <!-- Stock Status -->
                                        <li class="d-flex align-items-center mb-3">
                                            <strong class="me-2">Stock Status:</strong>
                                            <span class="badge bg-success text-white">
                                                <% if (product.varient) { %>
                                                    In Stock
                                                <% } else { %>
                                                   Out Off Stock
                                                <% } %>

                                                </span>
                                        </li>
                                    
                                        <!-- Tags -->
                                        <li class="d-flex align-items-center mb-3">
                                            <strong class="me-2">Tags:</strong>
                                            <div class="d-inline">
                                                <a href="#" class="badge bg-primary text-white" rel="tag"><%= category.name %></a>
                                            </div>
                                        </li>
                                    
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

<section class="product spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <ul class="filter__controls">
                    <li data-filter=".new-arrivals">YOU MAY ALSO LIKE</li>
                </ul>
            </div>
        </div>
        <div class="row product__filter">
            <% for(let i = 0; i < relatedProduct.length; i++) { %>
                <div class="col-lg-3 col-md-4 col-12 col-sm-6">
                    <div class="product-cart-wrap mb-30">
                        <div class="product-img-action-wrap">
                            <div class="product-img product-img-zoom">
                                <a href="/productDetails?id=<%= relatedProduct[i]._id %>">
                                    <img class="default-img" src="/uploads/re-image/<%= relatedProduct[i].productImage[0] %>" alt="<%= relatedProduct[i].productName %>">
                                </a>
                            </div>
                            <a href="javascript:void(0);" 
                            class="wishlist-btn" 
                            onclick="addToWishlist('<%= relatedProduct[i]._id %>')">
                             <i class="fas fa-heart"></i>
                         </a>
                        </div>
                        <div class="product-content-wrap">
                            <h6><%= relatedProduct[i].productName %></h6>
                            <h5>₹ <%= relatedProduct[i].salePrice %></h5>
                            
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
  </section>
    </section>
</main>
<style>
    #addToCartBtn {
      position: relative;
      overflow: hidden;
      transition: background-color 0.3s, transform 0.3s;
    }
  
    #addToCartBtn:hover {
      background-color: #28a745; /* Darker green on hover */
      transform: scale(1.05); /* Slightly enlarge the button */
    }
  
    #addToCartBtn:active {
      transform: scale(0.95); /* Slightly shrink the button on click */
    }
  
    /* Add a ripple effect */
    #addToCartBtn::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: rgba(255, 255, 255, 0.5);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: width 0.4s ease, height 0.4s ease;
    }
  
    #addToCartBtn:focus::after,
    #addToCartBtn:active::after {
      width: 200px;
      height: 200px;
      opacity: 0;
    }
  </style>



<script>
    // Change the main image function
    function changeMainImage(imagePath) {
        const zoomContainer = document.querySelector('.zoom-container');
        zoomContainer.style.backgroundImage = `url(${imagePath})`;
    }

    // Implement zoom functionality
    const zoomContainer = document.querySelector('.zoom-container');
    const mainImage = document.querySelector('#main-product-image');

    // Set background as the main image
    zoomContainer.style.backgroundImage = `url(${mainImage.src})`;
    mainImage.style.visibility = "hidden";

    // Mouse movement for zoom
    zoomContainer.addEventListener('mousemove', (e) => {
        const rect = zoomContainer.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;

        zoomContainer.style.backgroundPosition = `${x}% ${y}%`;
    });

    // Wheel zoom functionality
    let scale = 1;
    zoomContainer.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomStep = 0.1;

        if (e.deltaY < 0) {
            scale = Math.min(scale + zoomStep, 3);
        } else {
            scale = Math.max(scale - zoomStep, 1);
        }

        zoomContainer.style.backgroundSize = `${scale * 100}%`;
    });
</script>
<script>

document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.size-button');
  const label = document.getElementById('size-label');
  const availabilityText = document.getElementById('availability');

  // Ensure `sizeAvailability` is parsed correctly
  const sizeAvailability =<%- JSON.stringify({
    small: product.varient?.small || 0,
    medium: product.varient?.medium || 0,
    large: product.varient?.large || 0,
    xLarge: product.varient?.xLarge || 0,
  }) %>;

  // Define `selectedSize` in the broader scope
  let selectedSize = 'small'; // Default selected size

  // Size button logic
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      selectedSize = button.getAttribute('data-size'); // Update the global `selectedSize`

      // Update label text
      label.textContent = `Size: ${selectedSize}`;

      // Update availability text
      const availableCount = sizeAvailability[selectedSize];
      const availability = availableCount > 0 ? `${availableCount} Available` : 'Out of stock';
      availabilityText.textContent = `Stock: ${availability}`;
      availabilityText.style.color = availableCount > 0 ? "green" : "red";

      // Update button styles
      buttons.forEach(btn => {
        if (btn.getAttribute('data-size') === selectedSize) {
          btn.style.border = '2px solid black';
          btn.style.backgroundColor = '#f0f0f0';
          btn.style.fontWeight = 'bold';
        } else {
          btn.style.border = '1px solid gray';
          btn.style.backgroundColor = '#fff';
          btn.style.fontWeight = 'normal';
        }
      });
    });
  });

  // Quantity Selector Logic
  const quantityInput = document.getElementById('quantity');
  const increaseBtn = document.getElementById('increase-btn');
  const decreaseBtn = document.getElementById('decrease-btn');

  if (quantityInput && increaseBtn && decreaseBtn) {
    increaseBtn.addEventListener('click', () => {
      let currentValue = parseInt(quantityInput.value);
      const maxValue = parseInt(quantityInput.max);

      if (currentValue < maxValue) {
        quantityInput.value = currentValue + 1;
      }
    });

    decreaseBtn.addEventListener('click', () => {
      let currentValue = parseInt(quantityInput.value);
      const minValue = parseInt(quantityInput.min);

      if (currentValue > minValue) {
        quantityInput.value = currentValue - 1;
      }
    });
  } else {
    console.error("Quantity input or buttons not found.");
  }

  // Add to Cart Logic
  const addToCartBtn = document.getElementById('addToCartBtn');
  if (addToCartBtn) {
    addToCartBtn.addEventListener('click', async () => {
      // Retrieve product details dynamically
      const productIdElement = document.querySelector('input[name="productId"]');
      const productNameElement = document.querySelector('input[name="productName"]');
      const productImageElement = document.querySelector('input[name="productImage"]');
      const regularPriceElement = document.querySelector('input[name="regularPrice"]');
      const salePriceElement = document.querySelector('input[name="salePrice"]');

      if (!productIdElement || !productNameElement || !productImageElement || !regularPriceElement || !salePriceElement) {
        console.error("One or more product detail elements are missing.");
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Failed to retrieve product details. Please refresh the page and try again.',
        });
        return;
      }

      const productId = productIdElement.value;
      const quantity = quantityInput ? quantityInput.value : 1; // Default to 1 if quantityInput is missing
      const productName = productNameElement.value;
      const productImage = productImageElement.value;
      const regularPrice = regularPriceElement.value;
      const salePrice = salePriceElement.value;

      try {
        // Perform the AJAX request
        const response = await fetch('/addCart', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            productId,
            quantity,
            productName,
            productImage,
            regularPrice,
            salePrice,
            size: selectedSize, // Include the selected size
          }),
        });

        const result = await response.json();

        // Handle success and error with SweetAlert
        if (result.success) {
          Swal.fire({
            icon: 'success',
            title: 'Added to Cart!',
            text: result.message,
            showConfirmButton: false,
            timer: 1500,
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Oops...',
            text: result.message,
          });
        }
      } catch (error) {
        console.error('Error:', error);

        // Handle network or unexpected errors
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Failed to add to cart. Please try again later.',
        });
      }
    });
  } else {
    console.error("Add to Cart button not found.");
  }
});

async function addToWishlist(productId) {
    try {
        const response = await fetch('/addToWishlist', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ productId }),
        });

        // Log the raw response
        const responseText = await response.text();
        console.log("Raw response text:", responseText);

        // If the response is valid JSON, try to parse it
        if (responseText) {
            let data;
            try {
                data = JSON.parse(responseText);
            } catch (e) {
                throw new Error('Failed to parse JSON response');
            }

            console.log(data);
            if (data.status) {
                Swal.fire({
                    icon: 'success',
                    title: 'Added!',
                    text: 'Product added to wishlist',
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: data.message || 'Failed to add to wishlist',
                });
            }
        }
    } catch (error) {
        console.error('Error adding to wishlist:', error);
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred while adding to the wishlist.',
        });
    }
}

  </script>
  
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<%- include("../../views/partials/user/footer") %>
