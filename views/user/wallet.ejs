<%- include("../../views/partials/user/header") %>

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f4f6f9;
        color: #333;
    }

    .profile-container {
        max-width: 1100px;
        margin: 40px auto;
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .profile-sidebar {
        width: 280px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        padding: 20px;
    }

    .profile-sidebar h3 {
        font-size: 1.4rem;
        color: #0056b3;
        margin-bottom: 20px;
        text-align: center;
    }

    .profile-sidebar ul {
        list-style: none;
        padding: 0;
    }

    .profile-sidebar ul li {
        margin: 15px 0;
    }

    .profile-sidebar a {
        color: #555;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        padding: 10px 15px;
        border-radius: 8px;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    .profile-sidebar a:hover,
    .profile-sidebar a.active {
        background-color: #0056b3;
        color: #fff;
    }

    .profile-content {
        flex: 1;
        background: #fff;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card {
        background-color: #fff;
        border-radius: 8px;
        border: 1px solid #ddd;
        margin-bottom: 20px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background-color: #0056b3;
        color: #fff;
        padding: 15px;
        border-radius: 8px 8px 0 0;
        font-size: 1.2rem;
        font-weight: bold;
    }

    .card-body {
        padding: 20px;
        color: #333;
    }

    .btn-small {
        background-color: #0056b3;
        color: #fff;
        border: none;
        border-radius: 5px;
        padding: 8px 15px;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        transition: background-color 0.3s ease;
    }

    .btn-small:hover {
        background-color: #003f7f;
    }

    .transaction-list {
        max-height: 300px;
        overflow-y: auto;
        margin-top: 20px;
    }

    .transaction-list table {
        width: 100%;
        border-collapse: collapse;
    }

    .transaction-list th,
    .transaction-list td {
        text-align: left;
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

    .transaction-list th {
        background-color: #f4f4f4;
    }

    .transaction-list tr:hover {
        background-color: #f9f9f9;
    }
</style>

<div class="profile-container">
    <!-- Sidebar -->
    <div class="profile-sidebar">
        <h3>Dashboard</h3>
        <ul>
            <li><a href="/userprofile"><i class="fas fa-user"></i> Profile</a></li>
            <li><a href="/getaddress"><i class="fas fa-map-marker-alt"></i> My Address</a></li>
            <li><a href="/myOrder"><i class="fas fa-shopping-cart"></i> My Orders</a></li>
            <li><a href="/wallet" class="active"><i class="fas fa-wallet"></i> Wallet</a></li>
            <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="profile-content">
        <h2>Wallet</h2>
        <div class="card">
            <div class="card-header">Wallet Balance</div>
            <div class="card-body">
                <h3>₹ <%= wallet.balance.toFixed(2) %></h3>
                <form id="addFundsForm" style="margin-top: 20px;">
                    <label for="amount" style="display: block; margin-bottom: 8px;">Add Funds:</label>
                    <input type="number" id="amount" name="amount" required style="padding: 8px; width: 200px; margin-right: 10px;" />
                    <button type="submit" class="btn-small">Add</button>
                </form>
        </div>

        <div class="card">
            <div class="card-header">Transaction History</div>
            <div class="card-body transaction-list">
                <% if (wallet.transactions.length > 0) { %>
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Type</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% wallet.transactions.forEach(transaction => { %>
                                <tr>
                                    <td><%= new Date(transaction.date).toLocaleString() %></td>
                                    <td><%= transaction.description %></td>
                                    <td><%= transaction.type === "credit" ? "Credit" : "Debit" %></td>
                                    <td><%= transaction.type === "credit" ? "+" : "-" %>₹<%= transaction.amount.toFixed(2) %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <p>No transactions found.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>
<script>
    document.getElementById('addFundsForm').addEventListener('submit', async function (event) {
        event.preventDefault();

        const amount = document.getElementById('amount').value;

        if (amount <= 0) {
            Swal.fire({
                icon: 'error',
                title: 'Invalid Amount',
                text: 'Please enter a valid amount to add!',
            });
            return;
        }

        try {
            // Send a POST request to the backend
            const response = await fetch('/wallet', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ amount }),
            });

            const result = await response.json();

            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Funds Added',
                    text: `₹${amount} has been added to your wallet successfully!`,
                }).then(() => {
                    // Reload the page to reflect updated balance
                    location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error Adding Funds',
                    text: result.message || 'Something went wrong. Please try again later.',
                });
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Error Adding Funds',
                text: 'Unable to process your request at the moment.',
            });
            console.error(error);
        }
    });
</script>

<%- include("../../views/partials/user/footer") %>
