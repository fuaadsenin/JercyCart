<%- include("../../views/partials/user/header") %>
<main class="main">
   <div class="page-header breadcrumb-wrap">
       <div class="container">
           <div class="breadcrumb">
               <a href="/" rel="nofollow">Home</a>
               <span></span> Shop
               <span></span> My Wishlist
           </div>
       </div>
   </div>

   <section class="mt-50 mb-50">
       <div class="container">
           <div class="row">
               <div class="col-12">
                   <div class="table-responsive">
                       <table class="table shopping-summery text-center clean">
                           <thead>
                               <tr class="main-heading">
                                   <th scope="col">Image</th>
                                   <th scope="col">Name</th>
                                   <th scope="col">Price</th>
                                   <th scope="col">click here</th>
                                   <th scope="col">Remove</th>
                               </tr>
                           </thead>
                           <tbody>
                            <% if (wishlist.length > 0) { %>
                                <% for (let product of wishlist) { %>
                                    <tr>
                                        <td class="image product-thumbnail">
                                            <img src="/uploads/re-image/<%= product.productImage[0] %>" style="width: 100px; height: 100px; object-fit: cover;" />
                                        </td>
                                        <td class="product-des product-name">
                                            <h5 class="product-name">
                                                <!-- <a href="<%= product.productName %>"> -->
                                                    <%= product.productName %>
                                                <!-- </a> -->
                                            </h5>
                                            <p class="font-xs">
                                                <%= product.category.name %>
                                                <br />
                                            </p>
                                        </td>
                                        <td class="price" data-title="Price">₹<span>
                                            <%= product.salePrice %>
                                        </span></td>
                                        <td class="text-center" data-title="Add to Cart">
                                            <a href="/productDetails?id=<%= product._id %>" class="btn btn-primary">enter</a>
                                        </td>
                                        <td class="action" data-title="Remove">
                                            <a class="btn btn-sm " href="#" onclick="remove('<%=product._id%>')" style="background-color: red; color: white;">Remove
                                                <i class="fi-rs-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                <% } %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center">
                                        <p class="lead mb-4">No items found in Wishlist</p>
                                    </td>
                                </tr>
                            <% } %>
                           </tbody>
                       </table>
                   </div>
               </div>
           </div>
       </div>
   </section>
</main>
<%- include("../../views/partials/user/footer") %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    async function remove(productId) {
        try {
            const response = await fetch("/removeFromWishlist", {
                method: "POST",
                headers: {
                    'Content-Type': "application/json"
                },
                body: JSON.stringify({ productId }),
            });

            const data = await response.json();
            
            if (response.ok && data.status) {
                Swal.fire({
                    icon: 'success', // Fixed typo here
                    title: 'Removed!',
                    text: data.message || "Product successfully removed"
                }).then(() => {
                    window.location.reload(); // Redirect after the popup closes
                });
            } else {
                Swal.fire({
                    icon: "error",
                    title: "Oops",
                    text: data.message || "Error in removing product"
                });
            }

        } catch (error) {
            console.error("Error in removing:", error);
            Swal.fire({
                icon: "error",
                title: "Error",
                text: "An error occurred while removing the product"
            });
        }
    }
</script>
