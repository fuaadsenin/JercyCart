<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../../views/partials/user/header") %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About Us - JercyCart</title>
  <link rel="stylesheet" href="/styles/main.css">
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
  <style>
    body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
  color: #333;
}

.header {
  background: #f8f8f8;
  padding: 20px;
  border-bottom: 1px solid #ddd;
}

.header h1 {
  color: #d72d2d;
}

nav ul {
  list-style: none;
  display: flex;
  gap: 15px;
}

nav ul li {
  display: inline;
}

nav ul li a {
  text-decoration: none;
  color: #333;
  font-weight: bold;
}

.hero {
  text-align: center;
  padding: 50px 20px;
  background: #f5f5f5;
}

.hero h2 {
  font-size: 2.5rem;
  color: #d72d2d;
}

.section {
  padding: 30px 20px;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
}

.social-links a {
  margin-right: 10px;
  color: #333;
  font-size: 1.5rem;
}

.footer {
  background: #f8f8f8;
  text-align: center;
  padding: 20px 0;
  border-top: 1px solid #ddd;
}

.footer p {
  color: #666;
}

  </style>
</head>
<body>
  <header class="header">
    <div class="container">
      <!-- <h1>JercyCart</h1> -->
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/shop">Shop</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="about-us">
    <section class="hero">
      <div class="container">
        <h2>About JercyCart</h2>
        <p>Your ultimate destination for premium jerseys and sports apparel. We bring passion, quality, and style to every fan’s wardrobe.</p>
      </div>
    </section>

    <section class="our-story">
      <div class="container">
        <h3>Our Story</h3>
        <p>
          Founded in 2025, JercyCart started with a simple vision: to connect fans with the highest quality jerseys that celebrate their love for the game.
          From humble beginnings, we've grown into a trusted brand serving customers across the globe.
        </p>
      </div>
    </section>

    <section class="mission">
      <div class="container">
        <h3>Our Mission</h3>
        <p>
          At JercyCart, our mission is to provide sports enthusiasts with apparel that blends authenticity, style, and comfort.
          Whether you're cheering from the stands or playing on the field, we’ve got you covered.
        </p>
      </div>
    </section>

    <section class="team">
      <div class="container">
        <h3>Meet Our Team</h3>
        <p>
          Behind every great jersey is a dedicated team of designers, creators, and customer support specialists
          working to bring you the best experience possible. Passion for sports drives everything we do!
        </p>
      </div>
    </section>

    <section class="contact">
      <div class="container">
        <h3>Contact Us</h3>
        <p>
          Have questions or need assistance? Our support team is here to help!
        </p>
        <ul>
          <li><i class="fas fa-envelope"></i> Email: <a href="mailto:support@jercycart.com">support@jercycart.com</a></li>
          <li><i class="fas fa-phone"></i> Phone: +1-800-555-1234</li>
        </ul>
        <div class="social-links">
          <a href="#"><i class="fab fa-facebook"></i></a>
          <a href="#"><i class="fab fa-twitter"></i></a>
          <a href="#"><i class="fab fa-instagram"></i></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; 2025 JercyCart. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
